# shoulder-daemon — environment configuration for deploy/docker-compose.yml
#
# Copy this file to deploy/.env and fill in real values:
#   cp deploy/.env.example deploy/.env
#
# deploy/.env is gitignored — never commit it.

# ---------------------------------------------------------------------------
# shoulderd (relay)
# ---------------------------------------------------------------------------

# Shared secret that Claude Code's http hooks must present in the
# X-Shoulder-Token header on every request to shoulderd. Without this token
# any local process could inject text into a live coding session (see plan
# section 9, "Another local process posts to the relay").
#
# Generate one with:
#   openssl rand -hex 32
SHOULDER_TOKEN=

# Base URL of the OpenAI-compatible advisor shoulderd calls after each Stop
# event. Inside the compose network this is the advisor service's internal
# DNS name -- the advisor is never published to the host (plan section 4.6).
ADVISOR_BASE_URL=http://advisor:9090

# ---------------------------------------------------------------------------
# advisor (advisor-echo reference image by default; swap the image or
# ADVISOR_BASE_URL to point at a different OpenAI-compatible backend -- see
# docs/ADVISOR.md for real examples: Ollama, vLLM/llama.cpp, LiteLLM).
# ---------------------------------------------------------------------------

# Behaviour of advisor-echo:
#   noop  -> always replies "NOOP" (stay silent); safe default for wiring tests
#   fixed -> always replies with ECHO_TEXT below
#   echo  -> replies with a summary of the last user message (first 200 chars),
#            useful to prove the relay -> advisor -> relay round trip visually
ECHO_MODE=noop

# Reply text used when ECHO_MODE=fixed.
ECHO_TEXT=shoulder-daemon advisor: consider double-checking edge cases before proceeding.

# Artificial per-request delay in milliseconds, for testing that shoulderd
# keeps the advisor off the hot path (plan principle 2). 0 disables it.
ECHO_DELAY_MS=0

# Fraction (0.0-1.0) of requests advisor-echo answers with HTTP 500, for
# testing shoulderd's fail-open behaviour (plan A8). 0 disables it.
ECHO_FAIL_RATE=0
